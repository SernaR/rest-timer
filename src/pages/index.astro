<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="description" content="Minuteur de temps de repos entre deux séries." />
		<meta name="theme-color" content="#111111" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Repos" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Rest timer</title>
	</head>
	<body data-state="idle" data-phase="normal">
		<main class="app">
			<button type="button" class="countdown" id="countdown" aria-label="Annuler le repos">
				<svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
					<circle class="ring-track" cx="50" cy="50" r="45" />
					<circle class="ring-progress" id="ring" cx="50" cy="50" r="45" pathLength="1" />
				</svg>
				<span class="count" id="count">60</span>
				<span class="go">GO</span>
			</button>

			<nav class="durations" aria-label="Lancer un repos">
				<button type="button" class="duration" data-duration="30">
					<span>30<span class="unit">s</span></span>
				</button>
				<button type="button" class="duration" data-duration="60">
					<span>60<span class="unit">s</span></span>
				</button>
			</nav>
		</main>
	</body>
</html>

<style is:global>
	/* ---- Couleurs par phase -------------------------------------------- */
	:root {
		--neutral-bg: #111111;
		--neutral-fg: #f5f5f5;
		--orange: #ff9500;
		--red: #ff3b30;
		--green: #34c759;

		--bg: var(--neutral-bg);
		--fg: var(--neutral-fg);
		--accent: var(--neutral-fg);
	}

	/* Préavis (≤ 10 s) : fond orange sombre, anneau orange vif. */
	body[data-phase='warning'] {
		--bg: #5c3200;
		--accent: var(--orange);
	}

	/* Décompte final (≤ 5 s) : fond rouge sombre, anneau rouge vif. */
	body[data-phase='final'] {
		--bg: #5e0d09;
		--accent: var(--red);
	}

	/* Reprise : vert plein, texte sombre. */
	body[data-state='go'] {
		--bg: var(--green);
		--fg: #062b12;
		--accent: var(--fg);
	}

	/* ---- Base ---------------------------------------------------------- */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}

	body {
		height: 100vh;
		height: 100dvh;
		padding: env(safe-area-inset-top) env(safe-area-inset-right)
			env(safe-area-inset-bottom) env(safe-area-inset-left);
		background: var(--bg);
		color: var(--fg);
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		font-variant-numeric: tabular-nums;
		transition: background-color 300ms ease;

		/* Tactile : pas de zoom au double-tap, pas de sélection ni de menu. */
		touch-action: manipulation;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		-webkit-tap-highlight-color: transparent;
	}

	button {
		font: inherit;
		color: inherit;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		cursor: pointer;
	}

	.app {
		height: 100%;
		display: grid;
		gap: 3vmin;
		padding: 3vmin;
	}

	/* ---- Boutons de durée ---------------------------------------------- */
	.durations {
		display: flex;
		gap: 3vmin;
		min-height: 0;
	}

	.duration {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.1em;
		border: 0.4vmin solid color-mix(in srgb, currentColor 25%, transparent);
		border-radius: 4vmin;
		background: color-mix(in srgb, currentColor 8%, transparent);
		font-weight: 700;
		line-height: 1;
		transition: background-color 120ms ease;
	}

	.duration:active {
		background: color-mix(in srgb, currentColor 22%, transparent);
	}

	.unit {
		margin-left: 0.08em;
		font-size: 0.35em;
		font-weight: 500;
		opacity: 0.7;
	}

	/* ---- Zone décompte ------------------------------------------------- */
	.countdown {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 0;
		min-width: 0;
		padding: 0;
		border: 0;
		background: none;
	}

	/* L'anneau remplit la zone sans l'agrandir : le viewBox le garde rond
	   et centré, à la taille du plus petit côté. */
	.ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
		overflow: visible;
	}

	.ring circle {
		fill: none;
		stroke-width: 4;
	}

	.ring-track {
		stroke: color-mix(in srgb, currentColor 15%, transparent);
	}

	.ring-progress {
		stroke: var(--accent);
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		transition: stroke 300ms ease;
	}

	.count {
		font-size: 42vmin;
		font-weight: 700;
		line-height: 1;
	}

	.go {
		display: none;
		font-size: 40vmin;
		font-weight: 900;
		line-height: 1;
		letter-spacing: 0.02em;
	}

	/* ---- État : accueil ------------------------------------------------ */
	body[data-state='idle'] .countdown {
		display: none;
	}

	body[data-state='idle'] .durations {
		flex-direction: column;
	}

	body[data-state='idle'] .duration {
		font-size: 30vmin;
	}

	/* ---- États : décompte et GO ---------------------------------------- */
	body:not([data-state='idle']) .app {
		grid-template-rows: minmax(0, 1fr) auto;
	}

	body:not([data-state='idle']) .durations {
		height: 18vmin;
	}

	body:not([data-state='idle']) .duration {
		font-size: 9vmin;
		border-radius: 3vmin;
	}

	body[data-state='go'] .ring,
	body[data-state='go'] .count {
		display: none;
	}

	body[data-state='go'] .go {
		display: block;
	}

	/* ---- Paysage ------------------------------------------------------- */
	@media (orientation: landscape) {
		body[data-state='idle'] .durations {
			flex-direction: row;
		}

		body:not([data-state='idle']) .app {
			grid-template-rows: minmax(0, 1fr);
			grid-template-columns: minmax(0, 1fr) auto;
		}

		body:not([data-state='idle']) .durations {
			flex-direction: column;
			height: auto;
			width: 22vmin;
		}
	}
</style>
